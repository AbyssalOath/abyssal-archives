# Build output
/target

# Secrets and local configuration (.env.example is the documented template)
.env
.env.*
!.env.example

# Generated by install.sh (Caddyfile.example is committed)
/Caddyfile
/Caddyfile.bak.*

# Data: uploaded/imported files, incoming folder, local volumes
/data/
/storage/
/incoming/
/volumes/
/docker-volumes/
docker-compose.override.yml

# Large binaries that must never be committed
*.iso
*.img
*.bin
*.torrent
# Database dumps made per the README (never commit them)
/backup*.sql
/backups/

# Tunnel tokens and other side env files
cloudflared.env
*.env

# Keys and certificates
*.pem
*.key
*.crt

# Logs
*.log

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.fleet/
*.code-workspace

# OS junk
.DS_Store
Thumbs.db
desktop.ini
