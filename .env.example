# Copy to .env (install.sh generates it for you) and fill in. Never commit .env.
# Values with spaces or special characters ($ # " etc.) must be single-quoted:
#   SITE_NAME='My $pecial Files #1'

# ---- Docker -------------------------------------------------------------------
# Prefix for container, image and volume names. Lowercase letters, digits, - and _.
COMPOSE_PROJECT_NAME=filehost
# "caddy" to run the bundled Caddy reverse proxy, empty otherwise.
COMPOSE_PROFILES=
# Host port for the app (the container always listens on 8080 internally).
HTTP_PORT=8080
# Host address the app port binds to. 127.0.0.1 when Caddy (or another local
# proxy) is the only way in; 0.0.0.0 to reach it from the network.
APP_HTTP_BIND=0.0.0.0

# ---- Database -----------------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=filehost
MARIADB_USER=filehost
MARIADB_PASSWORD=change-me
# Host-side MariaDB port (bound to 127.0.0.1 only).
DB_PORT=3306
# Used when running the binary on the host (cargo run). Inside Docker the app
# connects to mariadb:3306 instead (see docker-compose.yml).
DATABASE_URL=mysql://filehost:change-me@127.0.0.1:3306/filehost

# ---- Site -------------------------------------------------------------------------
# Required. Copied into the database at every start until changed in
# /admin/settings (then the admin page wins). See scripts/set-site-name.sh.
SITE_NAME='My File Site'
SITE_TAGLINE='Downloads and releases'
# Public address of the site, no trailing slash. Used in logs and as the base
# for absolute links (e.g. torrent web seeds).
PUBLIC_URL=http://localhost:8080
# Optional separate host for downloads, e.g. https://dl.example.com (no path).
# Blank = same host as the site (relative links). Same env/admin override
# rules as SITE_NAME. See scripts/set-download-url.sh.
DOWNLOAD_BASE_URL=
# Mark session cookies Secure (HTTPS only). Must be true behind HTTPS.
COOKIE_SECURE=false

# ---- Storage ----------------------------------------------------------------------
# local = filesystem under STORAGE_PATH. smb = stub (not implemented); see
# docs/STORAGE.md for using an SMB share via a host CIFS mount instead.
STORAGE_BACKEND=local
# Paths inside the container. Leave these as they are for Docker.
STORAGE_PATH=/data/storage
INCOMING_PATH=/data/incoming
# Host directories bind-mounted at the paths above. Must be writable by the
# container user, UID/GID 10001: sudo chown -R 10001:10001 <dir>
STORAGE_HOST_PATH=./data/storage
INCOMING_HOST_PATH=./data/incoming
# Files in the incoming folder modified more recently than this are treated as
# still being copied and cannot be imported yet.
IMPORT_MIN_AGE_SECS=30

# ---- Uploads ----------------------------------------------------------------------
# Browser upload for small files. Large files go through INCOMING_PATH
# (docs/IMPORT.md); Cloudflare caps request bodies at ~100 MB.
ALLOW_WEB_UPLOAD=true
# Max size of one browser upload request, in bytes (K/M/G suffixes allowed).
MAX_UPLOAD_BYTES=90000000

# Initial value of "Allow account requests" (/register) on the first start;
# afterwards change it in /admin/settings. Requests always need admin
# approval. See docs/MEMBERS.md.
ALLOW_REGISTRATION=false

# ---- Future (not active yet) -------------------------------------------------------
# .torrent generation (stub). When false, /download/<id>/torrent is a 404;
# when true it currently returns 501. See docs/TORRENTS.md.
TORRENT_ENABLED=false
# Comma-separated announce URLs.
TORRENT_TRACKERS=
# Piece size in bytes, a power of two (default 4 MiB).
TORRENT_PIECE_LENGTH=4194304
# ---- External sharing (all OFF by default; editable in /admin/settings) ------------
# Show admin-approved mirror / torrent links (Archive.org, GitHub, other
# servers) on public pages. Stored mirrors are kept when off.
EXTERNAL_MIRRORS_ENABLED=false
# Future generated torrents: public (DHT/PEX) instead of private-flagged.
# Public mode exposes the seeder's IP (the VPN IP if the seeder profile is
# used). Never run a seeder outside the VPN container.
TORRENT_DHT_ENABLED=false
# Stubs: no routes, no network calls (see docs/FUTURE.md).
MIRROR_DISCOVERY_ENABLED=false
FEDERATION_ENABLED=false

# Detached GPG signatures for SHA256SUMS (stub). When false,
# /p/<slug>/<version>/SHA256SUMS.asc is a 404; when true it serves the
# detached signature you made on your own machine and pasted on the release's
# Files page (only while it matches the current SHA256SUMS). See docs/VERIFYING.md.
SIGN_CHECKSUMS=false
# Metadata stripping for images/PDFs (stub; no strippers exist yet). Disk
# images, archives and binaries are NEVER modified. See docs/SANITIZE.md.
STRIP_METADATA=false
# ---- VPN seeder (compose profile "seeder"; ADVANCED, see docs/TORRENTS.md) ---------
# gluetun provider name and credentials. The provider must support port
# forwarding (gluetun: private internet access, protonvpn, perfect privacy,
# privatevpn). ProtonVPN + OpenVPN: append +pmp to the username.
VPN_SERVICE_PROVIDER=
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=
VPN_PORT_FORWARDING=on
# qBittorrent Web UI: published on 127.0.0.1:<port> of the host only.
QBT_WEBUI_PORT=8081
QBT_USERNAME=admin
# Generated by install.sh (openssl rand -hex 24).
QBT_PASSWORD=
# qBittorrent config directory on the host (pre-seeded by install.sh).
QBT_CONFIG_HOST_PATH=./data/qbittorrent
# For the future in-app integration (src/seeder.rs); unused today.
# Would be http://gluetun:8081 (plus FIREWALL_INPUT_PORTS=8081 on gluetun).
QBT_URL=
# Echo-IP service used by scripts/check-seeder-ip.sh (read from the shell
# environment, not by the app). Default: https://api.ipify.org
# ECHO_IP_URL=https://api.ipify.org

# SMB backend settings, documented for the future SMB backend; unused today.
# SMB_HOST=
# SMB_SHARE=
# SMB_USERNAME=
# SMB_PASSWORD=
# SMB_DOMAIN=

# ---- Security (safe defaults; docs/HARDENING.md, docs/SECURITY-REVIEW.md) ----------
# Sessions end after this much inactivity / this long after login.
SESSION_IDLE_TIMEOUT_MINS=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Argon2id password hashing (OWASP minimums; raising them upgrades hashes at
# the next login).
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
# Optional TOTP second factor (opt-in). The key encrypts TOTP secrets at rest;
# install.sh generates it (openssl rand -base64 32). Never change it while 2FA
# is enrolled. Locked out: docker compose exec app /app/filehost admin reset-2fa
TOTP_ENABLED=false
TOTP_ENCRYPTION_KEY=
# Forwarded headers are honored only from these proxy addresses (CIDRs).
TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# x-forwarded-for (default) or cf-connecting-ip (only if the origin is
# reachable exclusively through Cloudflare).
CLIENT_IP_HEADER=x-forwarded-for
# Opt-in admin surface reduction: admin/login/setup answer only to these
# client CIDRs and/or only on this host name (404 otherwise). Blank = off.
ADMIN_ALLOWED_CIDRS=
ADMIN_HOST=
# /setup works only until an admin exists; install.sh sets false afterwards.
SETUP_ENABLED=true
# Opt-in HSTS (needs COOKIE_SECURE=true and HTTPS reported by a trusted proxy).
HSTS_ENABLED=false
HSTS_INCLUDE_SUBDOMAINS=false
# Client IPs in logs: none, truncated (IPv4 /24, IPv6 /48) or full.
LOG_IP_MODE=truncated
# Abuse limits.
REQUEST_TIMEOUT_SECS=30
RATE_LIMIT_PER_MINUTE=600
MAX_CONNECTIONS=1024
MAX_CONNECTIONS_PER_IP=64
DOWNLOAD_MAX_CONCURRENT=64
DOWNLOAD_MAX_PER_IP=4
# Background hashing jobs (imports, recomputes, integrity checks) at once.
IMPORT_CONCURRENCY=1
# Imports/uploads are refused if they would leave less free space than this.
STORAGE_MIN_FREE_BYTES=1G
# Optional proxy for mirror Verify (http://, https://, socks5://, socks5h://)
# so mirror hosts see the proxy's IP, not this server's.
VERIFY_PROXY_URL=
# Container limits for the app.
APP_MEMORY_LIMIT=1g
APP_CPUS=2
# APP_PIDS_LIMIT=256
# Publish MariaDB on 127.0.0.1:DB_PORT for host tools (default: no host port).
# install.sh then sets COMPOSE_FILE=docker-compose.yml:docker-compose.db-publish.yml
DB_PUBLISH=false

# ---- Backups (scripts/backup.sh; read from the shell, not by the app) ------------
# BACKUP_DIR=./backups
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_GPG_RECIPIENT=ops@example.org

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,sqlx=warn
